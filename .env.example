# ===========================================
# Vanguard Environment Configuration
# Copy this file to .env and fill in the values
# ===========================================

# ==================== Application ====================
DEBUG=false
LOG_LEVEL=INFO

# ==================== Database ====================
POSTGRES_USER=vanguard
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=vanguard
DATABASE_URL=postgresql+asyncpg://vanguard:change_me_in_production@postgres:5432/vanguard

# ==================== Redis ====================
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:change_me_in_production@redis:6379/0

# ==================== CORS ====================
CORS_ORIGINS=https://vanguard.example.com,https://admin.vanguard.example.com

# ==================== JWT ====================
JWT_SECRET=change_me_to_random_64_char_string_minimum
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ==================== Telegram Bot ====================
BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash

# ==================== Proxy Service ====================
# Promoter accounts require a provider proxy. Evomi is the default.
PROXY_PROVIDER=evomi
PROMOTER_PROXY_REQUIRED=true
EVOMI_API_KEY=your_evomi_public_api_key
EVOMI_PRODUCT_CODE=rp
EVOMI_PROTOCOL=http
EVOMI_SESSION_TYPE=sticky
EVOMI_SESSION_LIFETIME_MINUTES=30
EVOMI_SESSION_NAMESPACE=vanguard
EVOMI_ADBLOCK=false

# ==================== External Services ====================
# XBoard API (for account management)
XBOARD_API_URL=https://api.xboard.example.com
XBOARD_API_KEY=your_xboard_api_key

# Vanguard <-> XBoard HMAC
VANGUARD_APP_ID=vanguard
VANGUARD_SIGNING_SECRET=replace_with_shared_hmac_secret
VANGUARD_CALLBACK_APP_ID=xboard
VANGUARD_CALLBACK_SIGNING_SECRET=replace_with_callback_hmac_secret

# LLM Service (OpenAI or similar)
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gpt-4

# ==================== Rate Limiting ====================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ==================== Monitoring ====================
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# ==================== Telegram Alerts ====================
TELEGRAM_ALERT_CHAT_ID=your_telegram_chat_id_for_alerts
