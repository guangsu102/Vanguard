# ===========================================
# Vanguard Environment Configuration
# Copy this file to .env and fill in the values
# ===========================================

# ==================== Application ====================
DEBUG=false
LOG_LEVEL=INFO

# ==================== Database ====================
POSTGRES_USER=vanguard
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=vanguard
DATABASE_URL=postgresql+asyncpg://vanguard:change_me_in_production@postgres:5432/vanguard

# ==================== Redis ====================
REDIS_PASSWORD=change_me_in_production
REDIS_URL=redis://:change_me_in_production@redis:6379/0
RISK_GUARD_FAIL_CLOSED=false

# ==================== CORS ====================
CORS_ORIGINS=https://vanguard.example.com,https://admin.vanguard.example.com

# ==================== JWT ====================
JWT_SECRET=change_me_to_random_64_char_string_minimum
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ==================== Telegram Bot ====================
BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_SESSION_ENCRYPTION_KEY=change_me_to_random_64_char_string_for_session_encryption

# ==================== NapCatQQ + OneBot 11 ====================
QQ_ONEBOT_ENABLED=false
QQ_ONEBOT_ACCOUNT_ID=
QQ_ONEBOT_HTTP_URL=http://napcat:3000
QQ_ONEBOT_WS_URL=ws://napcat:3001
# Generate a random value with at least 32 characters and configure the same token in NapCat.
QQ_ONEBOT_ACCESS_TOKEN=
QQ_ONEBOT_REQUEST_TIMEOUT_SECONDS=10
QQ_ONEBOT_MESSAGE_RETENTION_DAYS=30
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
NAPCAT_UID=1000
NAPCAT_GID=1000

# ==================== Proxy Service ====================
# Promoter accounts require a provider proxy. Evomi is the default.
PROXY_PROVIDER=evomi
PROMOTER_PROXY_REQUIRED=true
# Option A: use Evomi Public API
EVOMI_API_KEY=your_evomi_public_api_key
# Option B: use a static Evomi gateway
EVOMI_PROXY_HOST=
EVOMI_PROXY_PORT=
EVOMI_PROXY_USERNAME=
EVOMI_PROXY_PASSWORD=
EVOMI_PRODUCT_CODE=rp
EVOMI_PROTOCOL=http
EVOMI_SESSION_TYPE=sticky
EVOMI_SESSION_LIFETIME_MINUTES=30
EVOMI_SESSION_NAMESPACE=vanguard
EVOMI_ADBLOCK=false
EVOMI_COUNTRY_VERIFY_ENABLED=false
EVOMI_COUNTRY_VERIFY_ATTEMPTS=5
EVOMI_COUNTRY_VERIFY_TIMEOUT_SECONDS=8
EVOMI_COUNTRY_VERIFY_URL=http://ip-api.com/json/?fields=status,countryCode,query

# ==================== External Services ====================
# XBoard API (for account management)
XBOARD_API_URL=https://api.xboard.example.com
XBOARD_API_KEY=your_xboard_api_key

# Vanguard <-> XBoard HMAC
VANGUARD_APP_ID=vanguard
VANGUARD_SIGNING_SECRET=replace_with_shared_hmac_secret
VANGUARD_CALLBACK_APP_ID=xboard
VANGUARD_CALLBACK_SIGNING_SECRET=replace_with_callback_hmac_secret

# Sub2API Admin integration for campaign redeem-code coupons.
# Rotate the admin key before enabling this integration if it may have leaked.
SUB2API_ENABLED=false
SUB2API_BASE_URL=
SUB2API_ADMIN_API_KEY=
SUB2API_TIMEOUT=5
# Shared only with the Sub2API outbound webhook sender; minimum 32 chars.
SUB2API_ALERT_WEBHOOK_SECRET=
SUB2API_ALERT_TIMESTAMP_TOLERANCE=300
SUB2API_ALERT_IDEMPOTENCY_TTL_SECONDS=2592000

# LLM Service (OpenAI-compatible)
OPENAI_API_KEY=your_dh113_openai_api_key
# Do not use deprecated api.dh113.xyz. Leave empty for the official OpenAI endpoint
# or set your current OpenAI-compatible provider URL.
OPENAI_BASE_URL=
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
LLM_FAST_MODEL=gpt-5.6-luna

# ==================== Rate Limiting ====================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ==================== Monitoring ====================
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# ==================== Telegram Alerts ====================
TELEGRAM_ALERT_CHAT_ID=your_telegram_chat_id_for_alerts
