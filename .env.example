# ===========================================
# Vanguard Environment Configuration
# Copy this file to .env and fill in the values
# ===========================================

# ==================== Application ====================
DEBUG=false
LOG_LEVEL=INFO

# ==================== Self-owned Group Orchestration ====================
# Real Telegram side effects are disabled by default. In production, set
# P0_SAFETY_GATE_FAIL_CLOSED=true before explicitly enabling execution.
OWNED_GROUP_MODULE_ENABLED=true
OWNED_GROUP_EXECUTION_ENABLED=false
# Explicit Guardian governance binding and owned-group event handling remain
# disabled until the governance bridge is configured and verified.
OWNED_GROUP_GOVERNANCE_ENABLED=false
OWNED_GROUP_MESSAGING_ENABLED=false
# Account-level Persona has an independent static emergency switch and is off by default.
OWNED_GROUP_AI_PERSONA_ENABLED=false
P0_SAFETY_GATE_ENABLED=true
P0_SAFETY_GATE_FAIL_CLOSED=true
# Set true only to engage the static emergency stop.
OWNED_GROUP_KILL_SWITCH_ENABLED=false
# Total promoter accounts allowed in one operation, including the group owner.
OWNED_GROUP_ROLLOUT_MAX_ACCOUNTS=2000
CELERY_OWNED_GROUP_CONCURRENCY=1

# ==================== Database ====================
POSTGRES_USER=vanguard
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=vanguard
DATABASE_URL=postgresql+asyncpg://vanguard:change_me_in_production@postgres:5432/vanguard

# ==================== Redis ====================
# Canonical Redis configuration. Put the password in REDIS_URL.
REDIS_PASSWORD=
REDIS_URL=redis://:change_me_in_production@redis:6379/0
RISK_GUARD_FAIL_CLOSED=false

# ==================== CORS ====================
CORS_ORIGINS=https://vanguard.pipenai.xyz,http://localhost:3000

# ==================== JWT ====================
JWT_SECRET=change_me_to_random_64_char_string_minimum
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ==================== Telegram Bot ====================
BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_SESSION_ENCRYPTION_KEY=change_me_to_random_64_char_string_for_session_encryption
# 按天小批量把过期声明的 Telegram app_version 滚动到当前版本池
APP_VERSION_ROLL_ENABLED=true
APP_VERSION_ROLL_BATCH_SIZE=3

# ==================== NapCatQQ + OneBot 11 ====================
QQ_ONEBOT_ENABLED=false
QQ_ONEBOT_ACCOUNT_ID=
QQ_ONEBOT_HTTP_URL=http://napcat:3000
QQ_ONEBOT_WS_URL=ws://napcat:3001
# Generate a random value with at least 32 characters and configure the same token in NapCat.
QQ_ONEBOT_ACCESS_TOKEN=
QQ_ONEBOT_REQUEST_TIMEOUT_SECONDS=10
QQ_ONEBOT_MESSAGE_RETENTION_DAYS=30
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
NAPCAT_UID=1000
NAPCAT_GID=1000

# ==================== Proxy Service ====================
# Promoter accounts require a provider proxy. Evomi is the default.
PROXY_PROVIDER=evomi
PROMOTER_PROXY_REQUIRED=true
# Option A: use Evomi Public API
EVOMI_API_KEY=your_evomi_public_api_key
# Option B: use a static Evomi gateway
EVOMI_PROXY_HOST=
EVOMI_PROXY_PORT=
EVOMI_PROXY_USERNAME=
EVOMI_PROXY_PASSWORD=
EVOMI_PRODUCT_CODE=rp
EVOMI_PROTOCOL=http
EVOMI_SESSION_TYPE=hard
EVOMI_SESSION_LIFETIME_MINUTES=30
EVOMI_SESSION_NAMESPACE=vanguard
EVOMI_ADBLOCK=false
EVOMI_COUNTRY_VERIFY_ENABLED=false
EVOMI_COUNTRY_VERIFY_ATTEMPTS=5
EVOMI_COUNTRY_VERIFY_TIMEOUT_SECONDS=8
EVOMI_COUNTRY_VERIFY_URL=http://ip-api.com/json/?fields=status,countryCode,query

# ==================== External Services ====================
# Vanguard <-> XBoard HMAC
VANGUARD_APP_ID=vanguard
VANGUARD_SIGNING_SECRET=replace_with_shared_hmac_secret
VANGUARD_CALLBACK_APP_ID=xboard
VANGUARD_CALLBACK_SIGNING_SECRET=replace_with_callback_hmac_secret

# Sub2API Admin integration for campaign redeem-code coupons.
# Rotate the admin key before enabling this integration if it may have leaked.
SUB2API_ENABLED=false
SUB2API_BASE_URL=
SUB2API_ADMIN_API_KEY=
SUB2API_TIMEOUT=5
# Shared only with the Sub2API outbound webhook sender; minimum 32 chars.
SUB2API_ALERT_WEBHOOK_SECRET=
SUB2API_ALERT_TIMESTAMP_TOLERANCE=300
SUB2API_ALERT_IDEMPOTENCY_TTL_SECONDS=2592000

# LLM Service (OpenAI-compatible)
OPENAI_API_KEY=your_openai_api_key
# Leave empty for the official OpenAI endpoint or set your current compatible provider URL.
# or set your current OpenAI-compatible provider URL.
OPENAI_BASE_URL=
LLM_PROVIDER=openai
LLM_MODEL=gpt-6.1-sol
# Leave empty to reuse LLM_MODEL; set this only when a separate fast model is needed.
LLM_FAST_MODEL=gpt-6.1-sol
# Group ad-policy reviews use the shared endpoint by default. Enable the
# legacy dedicated endpoint only with a provider-compatible model and key.
GROUP_AD_POLICY_DEDICATED_ENABLED=false

# ==================== Telegram Alerts ====================
ALERT_CHAT_ID=your_telegram_chat_id_for_alerts

# ==================== Growth P0 controls ====================
# Metrics are safe to enable before the ledger/stream rollout. Keep the
# ledger and independent reconciliation disabled until migration 067 is applied.
GROWTH_METRICS_ENABLED=true
BUDGET_LEDGER_ENABLED=false
RECONCILIATION_STREAM_ENABLED=false
RECONCILIATION_SHADOW_MODE=true
RECONCILIATION_ACCOUNT_IDS=34
METRICS_SCRAPE_TOKEN=

# ==================== P1 runtime reliability (disabled by default) ====================
P1_RUNTIME_RELIABILITY_ENABLED=false
P1_SYNC_TARGET_PERCENT=35
P1_SYNC_CANARY_ACCOUNT_IDS=2
P1_SYNC_ROLLOUT_MODE=account_allowlist
P1_INBOX_CLAIM_BATCH_SIZE=20
P1_INBOX_CLAIM_LEASE_SECONDS=90
P1_INBOX_COALESCE_SECONDS=30
# Optional fixed UTC cutoff for separating historical inbox backlog from the
# ordinary 120-second SLO. Leave empty until the production baseline is known.
P1_INBOX_BASELINE_AT=
# P2 durable join/ad Outbox rollout (fail-closed until the migration and canary are ready)
P2_OUTBOX_ENABLED=false
P2_JOIN_OUTBOX_ENABLED=false
P2_AD_OUTBOX_ENABLED=false
P2_SHADOW_MODE=true
P2_ACCOUNT_IDS=
P2_OUTBOX_BATCH_SIZE=20
P2_OUTBOX_LEASE_SECONDS=300
P2_RECONCILIATION_MAX_AGE_SECONDS=3600
# P3 Telegram read-cache rollout (all lanes default off; enable independently)
P3_ENTITY_CACHE=false
P3_GROUP_FACT_CACHE=false
P3_SURVIVAL_CACHE=false
P3_QUALIFICATION_SNAPSHOT=false

# ==================== P4 ad fairness pacing, admin metrics and history governance ====================
# Every lane defaults off. Release order: enable admin metrics first (read-only
# observation), then pacing shadow mode, then real pacing for a canary; enable
# history governance in dry-run before allowing batched archive.
P4_AD_PACING=false
P4_AD_PACING_SHADOW=false
# Comma-separated canary account IDs for the first real pacing rollout; empty means all ads candidates.
P4_AD_PACING_ACCOUNT_IDS=
P4_SURVIVAL_BACKLOG_LIMIT=30
P4_UNRESOLVED_BACKLOG_LIMIT=20
P4_PACING_DECISION_RETENTION_DAYS=14
P4_ADMIN_METRICS=false
P4_HISTORY_GOVERNANCE=false
P4_HISTORY_GOVERNANCE_DRY_RUN=true
P4_HISTORY_HOT_RETENTION_DAYS=90
P4_HISTORY_AUDIT_RETENTION_DAYS=370
P4_HISTORY_ARCHIVE_BATCH_SIZE=200
