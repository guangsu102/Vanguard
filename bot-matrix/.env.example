# XBoard Bot Matrix - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ==================== Telegram 用户账号矩阵 ====================
# 从 https://my.telegram.org 获取 api_id 和 api_hash
# 使用手机号登录（带国际区号，如 +86138xxxxxxxx）

# 模块 A: 引流账号矩阵
LEAD_GEN_MAIN_PHONE=+86138xxxxxxxx
LEAD_GEN_MAIN_API_ID=12345678
LEAD_GEN_MAIN_API_HASH=0123456789abcdef0123456789abcdef

# 可添加更多引流辅助号
# LEAD_GEN_SUB1_PHONE=+86139xxxxxxxx
# LEAD_GEN_SUB1_API_ID=12345678
# LEAD_GEN_SUB1_API_HASH=0123456789abcdef0123456789abcdef

# 模块 B: 运营客服账号矩阵
SERVICE_PHONE_1=+86138xxxxxxxx
SERVICE_API_ID_1=12345678
SERVICE_API_HASH_1=0123456789abcdef0123456789abcdef

# 模块 C: 社群管理账号矩阵
ADMIN_PHONE_1=+86138xxxxxxxx
ADMIN_API_ID_1=12345678
ADMIN_API_HASH_1=0123456789abcdef0123456789abcdef

# ==================== XBoard API ====================
XBOARD_API_URL=http://localhost:8080/api
XBOARD_API_KEY=your_xboard_api_key_here

# ==================== PostgreSQL ====================
POSTGRES_PASSWORD=xboard_bot_password_change_me

# ==================== Redis ====================
REDIS_PASSWORD=redis_password_change_me

# ==================== 监控与告警 ====================
SENTRY_DSN=
ADMIN_CHAT_ID=

# ==================== 应用配置 ====================
APP_ENV=development
APP_DEBUG=true
