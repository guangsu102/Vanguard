# ===========================================
# Production Environment Variables
# DO NOT commit this file to version control!
# ===========================================

# ==================== Application ====================
DEBUG=false
LOG_LEVEL=INFO
LOG_STDOUT_LEVEL=INFO
# Optional application log file. The test001 growth worker sets this in Compose.
LOG_FILE=
LOG_RETENTION_DAYS=15

# ==================== Database ====================
POSTGRES_USER=vanguard
POSTGRES_PASSWORD=<SECURE_PASSWORD>
POSTGRES_DB=vanguard
DATABASE_URL=postgresql+asyncpg://vanguard:<SECURE_PASSWORD>@postgres:5432/vanguard

# ==================== Redis ====================
# Production compose joins the existing XBoard Redis network.
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
RISK_GUARD_FAIL_CLOSED=true

# ==================== CORS ====================
CORS_ORIGINS=https://vanguard.example.com,https://admin.vanguard.example.com

# ==================== JWT ====================
JWT_SECRET=<SECURE_SECRET_KEY>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ==================== Telegram Bot ====================
BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
TELEGRAM_API_ID=<TELEGRAM_API_ID>
TELEGRAM_API_HASH=<TELEGRAM_API_HASH>
TELEGRAM_SESSION_ENCRYPTION_KEY=<SECURE_64_CHAR_SESSION_ENCRYPTION_KEY>

# ==================== NapCatQQ + OneBot 11 ====================
QQ_ONEBOT_ENABLED=false
QQ_ONEBOT_ACCOUNT_ID=<DEDICATED_QQ_ACCOUNT_NUMBER>
QQ_ONEBOT_HTTP_URL=http://napcat:3000
QQ_ONEBOT_WS_URL=ws://napcat:3001
QQ_ONEBOT_ACCESS_TOKEN=<RANDOM_SECRET_MIN_32_CHARS>
QQ_ONEBOT_REQUEST_TIMEOUT_SECONDS=10
QQ_ONEBOT_MESSAGE_RETENTION_DAYS=30
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
NAPCAT_UID=1000
NAPCAT_GID=1000

# ==================== Proxy Service ====================
# Promoter accounts require a provider proxy. Evomi is the default.
PROXY_PROVIDER=evomi
PROMOTER_PROXY_REQUIRED=true
# Option A: use Evomi Public API
EVOMI_API_KEY=<EVOMI_PUBLIC_API_KEY>
# Option B: use a static Evomi gateway
EVOMI_PROXY_HOST=<EVOMI_PROXY_HOST>
EVOMI_PROXY_PORT=<EVOMI_PROXY_PORT>
EVOMI_PROXY_USERNAME=<EVOMI_PROXY_USERNAME>
EVOMI_PROXY_PASSWORD=<EVOMI_PROXY_PASSWORD>
EVOMI_PRODUCT_CODE=rp
EVOMI_PROTOCOL=http
EVOMI_SESSION_TYPE=sticky
EVOMI_SESSION_LIFETIME_MINUTES=30
EVOMI_SESSION_NAMESPACE=vanguard
EVOMI_ADBLOCK=false
EVOMI_COUNTRY_VERIFY_ENABLED=false
EVOMI_COUNTRY_VERIFY_ATTEMPTS=5
EVOMI_COUNTRY_VERIFY_TIMEOUT_SECONDS=8
EVOMI_COUNTRY_VERIFY_URL=http://ip-api.com/json/?fields=status,countryCode,query

# ==================== External Services ====================
# Vanguard <-> XBoard HMAC
VANGUARD_APP_ID=vanguard
VANGUARD_SIGNING_SECRET=<SHARED_HMAC_SECRET>
VANGUARD_CALLBACK_APP_ID=xboard
VANGUARD_CALLBACK_SIGNING_SECRET=<CALLBACK_HMAC_SECRET>

# Sub2API Admin integration for campaign redeem-code coupons.
# Use a newly rotated admin key and the public HTTPS API URL.
SUB2API_ENABLED=false
SUB2API_BASE_URL=https://api.sub2api.example.com
SUB2API_ADMIN_API_KEY=
SUB2API_TIMEOUT=5
# Must exactly match Sub2API VANGUARD_WEBHOOK_SECRET; minimum 32 chars.
SUB2API_ALERT_WEBHOOK_SECRET=<SHARED_HMAC_SECRET_MIN_32_CHARS>
SUB2API_ALERT_TIMESTAMP_TOLERANCE=300
SUB2API_ALERT_IDEMPOTENCY_TTL_SECONDS=2592000

# LLM Service (OpenAI-compatible)
OPENAI_API_KEY=<DH113_OPENAI_API_KEY>
# Do not use deprecated api.dh113.xyz. Leave empty for the official OpenAI endpoint
# or set your current OpenAI-compatible provider URL.
OPENAI_BASE_URL=
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
LLM_FAST_MODEL=gpt-5.6-luna

# ==================== Telegram Alerts ====================
ALERT_CHAT_ID=<ALERT_CHAT_ID>
