# =============================================================================
# Docker Ignore Configuration
# =============================================================================

# Git
.git
.gitignore

# Documentation
*.md
docs/

# IDE
.vscode/
.idea/
.codex*/
.chrome*/
.ruff_cache/

# Environment
.env
.env.*
!.env.example

# Python
__pycache__
*.py[cod]
venv/
.venv/

# Node (for backend)
node_modules/

# Logs
data/
logs/
*.log
*.tar
*.tar.gz

# Sessions (should be mounted as volume)
sessions/

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
backend/.pytest_cache/
.coverage
backend/.coverage
htmlcov/

# Temporary
tmp/
temp/
NUL
