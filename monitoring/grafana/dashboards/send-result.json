{
  "uid": "vanguard-send-result",
  "title": "Vanguard 发送结果",
  "description": "发送成功即计数。连续3次明确群发送失败后退群；广告存活复核已停用。今日按北京时间统计。",
  "tags": [
    "Vanguard",
    "发送结果"
  ],
  "timezone": "Asia/Shanghai",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "今日发送成功",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vanguard-prometheus"
      },
      "targets": [
        {
          "expr": "sum(vanguard_send_result_today{outcome=\"success\"}) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
