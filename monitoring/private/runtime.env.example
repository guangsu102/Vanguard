# Copy to /opt/vanguard/monitoring/private/runtime.env and chmod 600.
# Populate from the existing Vanguard runtime credentials without committing it.
DATABASE_URL=postgresql+asyncpg://vanguard_app:REDACTED@oracle-shared-postgres:5432/vanguard
REDIS_URL=redis://:REDACTED@vanguard-redis:6379/0
GROWTH_METRICS_ENABLED=true
BUDGET_LEDGER_ENABLED=false
RECONCILIATION_STREAM_ENABLED=false
RECONCILIATION_SHADOW_MODE=true
RECONCILIATION_ACCOUNT_IDS=34
METRICS_SCRAPE_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_TOKEN
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=0
